# Copy to .env for local runs. The Ansible deploy writes its own on the server.

OLLAMA_MODEL=gemma3:4b

# Shared secret for POST /improve. Empty leaves the endpoint open.
AGENT_API_KEY=

MAX_INPUT_CHARS=8000
DEFAULT_TEMPERATURE=0.2
# Generous, because Ollama releases the model after 5 minutes idle and a
# request that lands after that waits for it to load again.
REQUEST_TIMEOUT=300

NUM_PREDICT=1024
NUM_CTX=4096
WARMUP_ON_START=true
LOG_LEVEL=INFO
